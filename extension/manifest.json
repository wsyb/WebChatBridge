{
  "manifest_version": 3,
  "name": "Web Chat Bridge",
  "version": "0.2.0",
  "description": "Enable web AI chat services (DeepSeek, Kimi, Doubao) to access local/remote filesystem, execute commands, and control the browser",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "debugger",
    "windows"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "https://kimi.moonshot.cn/*",
    "https://www.kimi.com/*",
    "https://chat.deepseek.com/*",
    "https://www.doubao.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kimi.moonshot.cn/*",
        "https://www.kimi.com/*",
        "https://chat.deepseek.com/*",
        "https://www.doubao.com/*"
      ],
      "js": [
        "dist/content/index.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}